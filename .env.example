# Environment Configuration

# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env with real keys.

# ── LLM Provider ──────────────────────────────────────────────
# Active provider: gemini | openai | claude | local
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# ── API Keys ──────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
EXA_API_KEY=your-exa-api-key-here

# ── Security ──────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URL of the deployed backend, used for document download links.
# API_BASE_URL=https://your-render-service.onrender.com

# Supabase (required for a Render Free deployment; keep these server-side only)
# DATABASE_URL=postgresql+psycopg://postgres:password@host:6543/postgres?sslmode=require
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=research-files

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
